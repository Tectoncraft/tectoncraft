# Public site
NEXT_PUBLIC_SITE_URL=https://tectoncraft.com

# Supabase: Project Settings → API. The service-role key bypasses RLS: server only, never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: the from-address must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tectoncraft <hello@tectoncraft.com>"
# Where quote / negotiate notifications go.
QUOTE_NOTIFY_EMAIL=

# Cloudflare Turnstile. For local dev you can use Cloudflare's test keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (always passes)
# In production a missing secret rejects every public form submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
